{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Metuur: auto start",
      "type": "process",
      "command": "${workspaceFolder}\\bin\\metuur.exe",
      "dependsOn": "Metuur: build",
      "dependsOrder": "sequence",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Metuur: build",
      "type": "shell",
      "command": "go",
      "args": ["build", "-buildvcs=false", "-trimpath", "-o", "${workspaceFolder}\\bin\\metuur.exe", "./cmd/metuur"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$go"
    },
    {
      "label": "Metuur: test",
      "type": "shell",
      "command": "go",
      "args": ["test", "./..."],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$go"
    },
    {
      "label": "Metuur: run",
      "type": "shell",
      "command": "${workspaceFolder}\\bin\\metuur.exe",
      "dependsOn": "Metuur: build",
      "problemMatcher": []
    },
    {
      "label": "Metuur: install",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\install.ps1"
      ],
      "problemMatcher": []
    }
  ]
}
